# ============================================================
# BlockOS ESP32 build
# Classic ESP32 / Xtensa LX6
# Produces: build/esp32/blockos-esp32.elf
#           build/esp32/blockos-esp32.bin
# ============================================================

ESP32_DIR      := arch/esp32
ESP32_BUILD    := build/esp32
ESP32_CXX      ?= xtensa-esp32-elf-g++
ESP32_OBJCOPY  ?= xtensa-esp32-elf-objcopy
ESPTOOL        ?= esptool
PYTHON         ?= python3

# Kconfig output is generated by the top-level make.
-include include/generated/config.mk

ELF_OUT        := $(ESP32_BUILD)/blockos-esp32.elf
BIN_OUT        := $(ESP32_BUILD)/blockos-esp32.bin
LD_SCRIPT      := $(ESP32_DIR)/linker.ld

CPP_SRC := \
	$(wildcard $(ESP32_DIR)/*.cpp) \
	$(wildcard $(ESP32_DIR)/drivers/*.cpp)

ASM_SRC := $(ESP32_DIR)/start.S
CPP_OBJ := $(addprefix $(ESP32_BUILD)/,$(CPP_SRC:.cpp=.o))
ASM_OBJ := $(ESP32_BUILD)/arch/esp32/start_asm.o
OBJ := $(CPP_OBJ) $(ASM_OBJ)
DEP := $(OBJ:.o=.d)

CXXFLAGS := \
	-std=gnu++17 \
	-mlongcalls \
	-mtext-section-literals \
	-mabi=windowed \
	-ffreestanding \
	-fno-exceptions \
	-fno-rtti \
	-fno-threadsafe-statics \
	-fno-use-cxa-atexit \
	-fno-stack-protector \
	-fno-stack-check \
	-fno-common \
	-fno-builtin \
	-ffunction-sections \
	-fdata-sections \
	-fstrict-volatile-bitfields \
	-fno-strict-aliasing \
	-O2 \
	-Wall \
	-Wextra \
	-Wno-unused-parameter \
	-DESP32=1 \
	-DBLOCKOS_ARCH_ESP32=1 \
	-I. \
	-I$(ESP32_DIR) \
	-I$(ESP32_DIR)/drivers \
	-Iinclude \
	-MMD \
	-MP

ASFLAGS := \
	-mlongcalls \
	-mtext-section-literals \
	-mabi=windowed \
	-ffreestanding \
	-DESP32=1 \
	-DBLOCKOS_ARCH_ESP32=1 \
	-I. \
	-I$(ESP32_DIR) \
	-I$(ESP32_DIR)/drivers \
	-MMD \
	-MP

LDFLAGS := \
	-nostdlib \
	-nodefaultlibs \
	-nostartfiles \
	-Wl,-T$(LD_SCRIPT) \
	-Wl,--gc-sections \
	-Wl,--no-relax

.PHONY: all clean esp32-image flash

all: $(BIN_OUT)

$(ESP32_BUILD):
	@mkdir -p $@

$(ESP32_BUILD)/%.o: %.cpp
	@mkdir -p $(dir $@)
	@echo "[ESP32 CXX] $<"
	$(ESP32_CXX) $(CXXFLAGS) -c $< -o $@

$(ASM_OBJ): $(ASM_SRC)
	@mkdir -p $(dir $@)
	@echo "[ESP32 ASM] $<"
	$(ESP32_CXX) $(ASFLAGS) -c $< -o $@

$(ELF_OUT): $(OBJ)
	@mkdir -p $(ESP32_BUILD)
	@echo "[ESP32 LINK] $@"
	$(ESP32_CXX) $(CXXFLAGS) $(LDFLAGS) $(OBJ) -lgcc -o $@
	@echo "[OK] $@"

$(BIN_OUT): $(ELF_OUT)
	@mkdir -p $(ESP32_BUILD)
	@echo "[ESP32 IMAGE] $@"
	@set -eu; \
	if command -v $(ESPTOOL) >/dev/null 2>&1; then \
		$(ESPTOOL) --chip ESP32 elf2image \
			--flash-mode dio \
			--flash-freq 40m \
			--flash-size 4MB \
			--output $@ $<; \
	elif command -v esptool.py >/dev/null 2>&1; then \
		esptool.py --chip ESP32 elf2image \
			--flash_mode dio \
			--flash_freq 40m \
			--flash_size 4MB \
			--output $@ $<; \
	elif $(PYTHON) -c 'import esptool' >/dev/null 2>&1; then \
		$(PYTHON) -m esptool --chip ESP32 elf2image \
			--flash-mode dio \
			--flash-freq 40m \
			--flash-size 4MB \
			--output $@ $<; \
	else \
		echo '[ERROR] esptool is required to create the ESP32 .bin image.'; \
		exit 1; \
	fi
	@echo "[OK] $@"

esp32-image: $(BIN_OUT)

flash: $(BIN_OUT)
	@set -eu; \
	if command -v $(ESPTOOL) >/dev/null 2>&1; then \
		$(ESPTOOL) --chip ESP32 --port "$${ESP32_PORT:-/dev/ttyUSB0}" write-flash 0x10000 $<; \
	elif command -v esptool.py >/dev/null 2>&1; then \
		esptool.py --chip ESP32 --port "$${ESP32_PORT:-/dev/ttyUSB0}" write_flash 0x10000 $<; \
	else \
		echo '[ERROR] esptool is required for flashing.'; \
		exit 1; \
	fi

clean:
	rm -rf $(ESP32_BUILD)

-include $(DEP)
